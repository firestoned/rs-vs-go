# cmbench configuration. Override any value via the environment: TRIALS=4 ./scripts/bench.sh
# Required: the k0s worker node to measure on. Use a dedicated worker, not a controller+worker.
BENCH_NODE=${BENCH_NODE:-}

BENCH_NS=${BENCH_NS:-cmbench}
PROBE_NS=${PROBE_NS:-cmbench-probe}

RS_IMAGE=${RS_IMAGE:-registry.local/cmbench/cmwatch-rs:0.2.0}
GO_IMAGE=${GO_IMAGE:-registry.local/cmbench/cmwatch-go:0.2.0}
SAMPLER_IMAGE=${SAMPLER_IMAGE:-docker.io/library/bash:5.2}
PERF_IMAGE=${PERF_IMAGE:-registry.local/cmbench/perf:0.2.0}

# Trials per implementation. Order is counterbalanced (ABBA...) and runs are strictly sequential.
# Each trial is ~2h10m with the defaults below, so TRIALS=3 is ~13h for both implementations.
TRIALS=${TRIALS:-3}
IMPLS=${IMPLS:-"rs go"}

# Timeline per trial (seconds). Sampling is continuous; these only label windows.
WARMUP_S=${WARMUP_S:-300}          # after sync, excluded from the baseline
IDLE_PRE_S=${IDLE_PRE_S:-3600}     # baseline BEFORE any ConfigMap churn
SETTLE_S=${SETTLE_S:-30}           # after create, and after delete
POST_NEAR_S=${POST_NEAR_S:-600}    # "right after": 0 to 10 min after churn
POST_MID_S=${POST_MID_S:-1200}     # 10 to 30 min after churn (recorded, not headline)
POST_LATE_S=${POST_LATE_S:-1800}   # "30 min later": 30 to 60 min after churn
COOLDOWN_S=${COOLDOWN_S:-60}

# Churn workload.
CM_COUNT=${CM_COUNT:-100}
CM_SIZE_BYTES=${CM_SIZE_BYTES:-1024}

# Sampler.
SAMPLE_MS=${SAMPLE_MS:-100}
SNAPSHOTS=${SNAPSHOTS:-true}       # SIGUSR1 runtime/allocator snapshot at each phase boundary

# Hardware cycle counters via perf (needs PERF_IMAGE on the node, privileged, and a PMU;
# on VMs enable virtual CPU performance counters).
ENABLE_PERF=${ENABLE_PERF:-false}
PERF_INTERVAL_MS=${PERF_INTERVAL_MS:-1000}

# Watcher resources (identical for both).
CPU_LIMIT=${CPU_LIMIT:-1}
MEM_LIMIT=${MEM_LIMIT:-256Mi}

# list = classic list+watch for both; streaming = WatchList streaming lists for both.
LIST_MODE=${LIST_MODE:-list}
# false = Go uses HTTP/1.1 like kube-rs (protocol held constant). true = client-go default
# HTTP/2 with its 30s ping health check. Run both arms if you want to see the difference.
GO_HTTP2=${GO_HTTP2:-false}

# Cordon BENCH_NODE for the duration of the run so nothing else lands on it.
CORDON=${CORDON:-true}
